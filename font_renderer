; Retrieves or rasterizes the bitmap for a given Unicode code point.
; ----------------------------------------------------------------------
; Parameters:
;   EAX: 32-bit Unicode Code Point
;
; Returns:
;   EAX: Pointer to the 32-bit glyph bitmap in the cache
;   EBX: Glyph advance width (how far to move the cursor)
; ----------------------------------------------------------------------
get_glyph_bitmap:
    pushad
    
    ; 1. Check Glyph Cache
    ; If the Unicode Code Point (EAX) is found in the cache, retrieve its bitmap pointer (EAX) and width (EBX).
    ; jmp .cache_hit
    
    ; 2. Rasterize the Glyph (Cache Miss)
    ; a. Look up the glyph index (using the TTF 'cmap' table).
    ; b. Read vector outlines (from the 'glyf' table).
    ; c. Run the **TrueType Rasterizer** to convert vector data to a pixel bitmap.
    
    ; 3. Store the result in the cache for future use.
    
.cache_hit:
    ; ... (Logic to return Ptr in EAX and Width in EBX)
    
    popad
    ret

; ----------------------------------------------------------------------
; Subroutine: render_string_unicode
; Main function to display a UTF-8 string, handling decoding and drawing.
; ----------------------------------------------------------------------
; Parameters:
;   ESI: Pointer to the UTF-8 encoded string
;   EAX: Starting X position (in pixels)
;   EBX: Starting Y position (in pixels)
render_string_unicode:
    pushad
    
    ; Use locals to track cursor position
    mov [current_x_pos_local], eax
    mov [current_y_pos_local], ebx

    mov edi, esi                ; EDI = Current read pointer (UTF-8 string)
    
.decode_loop:
    cmp byte [edi], 0x00
    je .done_rendering          ; End of string
    
    ; 1. Decode next Unicode Code Point
    mov esi, edi
    ; call unicode_decode_utf8   ; Returns 32-bit code point in ECX, advances EDI
    
    ; 2. Get the Glyph Bitmap
    mov eax, ecx                ; EAX
